REQUIRES: FileCheck

RUN: rm -rf %t.dir
RUN: mkdir -p %t.dir
RUN: %{swift} package init --package-path %t.dir --name Example
RUN: %{target_swift_build} --package-path %t.dir --build-tests
# swift-testing writes its report to stderr.
RUN: %{wasm_run} --dir . %t.dir/.build/debug/ExamplePackageTests.xctest --testing-library swift-testing 2>&1 | %{FileCheck} %s

CHECK: Test run started.
CHECK: Test example() passed
CHECK: Test run with 1 test in 0 suites passed
