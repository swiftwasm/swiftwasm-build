diff --git a/CMakeLists.txt b/CMakeLists.txt
index 084e9efc..1769b49a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,6 +14,16 @@ if(POLICY CMP0157)
     # toolchain, because the early swift-driver isn't (yet) available. Disable
     # it for now.
     cmake_policy(SET CMP0157 OLD)
+  elseif(SwiftTesting_DISABLE_SWIFT_SPLIT_COMPILATION)
+    # The split-compilation model drives swiftc with an output-file-map that
+    # only names 'object' outputs. When the compiler is asked for LTO
+    # ('-lto=llvm-full'/'-lto=llvm-thin') the driver produces LLVM bitcode
+    # instead and derives '<basename>.bc' names in the working directory, so
+    # the object files CMake expects are never created and the archive step
+    # fails. Builds that need bitcode libraries set
+    # SwiftTesting_DISABLE_SWIFT_SPLIT_COMPILATION to fall back to the one-step
+    # compile-and-archive model, which lets the driver name its own outputs.
+    cmake_policy(SET CMP0157 OLD)
   else()
     cmake_policy(SET CMP0157 NEW)
   endif()
@@ -53,8 +63,20 @@ include(PlatformInfo)
 include(SwiftModuleInstallation)
 
 option(SwiftTesting_INSTALL_NESTED_SUBDIR "Install libraries under a platform and architecture subdirectory" NO)
+
+# Library evolution lets a client built against a '.swiftinterface' keep working
+# with a differently-built copy of the testing library, and is what makes it
+# possible to ship only interfaces. It is incompatible with builds that seal the
+# whole program at link time -- '-experimental-hermetic-seal-at-link' and
+# '-enable-library-evolution' are mutually exclusive, since a resilient module
+# must keep its dispatch indirect. Turning this option off drops the flag,
+# stops emitting module interfaces, and installs the binary '.swiftmodule'
+# instead, so clients type-check against the very module the shipped libraries
+# were built from.
+option(SwiftTesting_ENABLE_LIBRARY_EVOLUTION "Build the testing library with library evolution enabled" YES)
 set(SwiftTesting_INSTALL_LIBDIR "${CMAKE_INSTALL_LIBDIR}/swift$<$<NOT:$<BOOL:${BUILD_SHARED_LIBS}>>:_static>/${SwiftTesting_PLATFORM_SUBDIR}$<$<AND:$<PLATFORM_ID:Darwin>,$<NOT:$<BOOL:${SwiftTesting_INSTALL_NESTED_SUBDIR}>>>:/testing>$<$<BOOL:${SwiftTesting_INSTALL_NESTED_SUBDIR}>:/${SwiftTesting_ARCH_SUBDIR}>")
 set(SwiftTesting_INSTALL_SWIFTMODULEDIR "${CMAKE_INSTALL_LIBDIR}/swift$<$<NOT:$<BOOL:${BUILD_SHARED_LIBS}>>:_static>/${SwiftTesting_PLATFORM_SUBDIR}$<$<AND:$<PLATFORM_ID:Darwin>,$<NOT:$<BOOL:${SwiftTesting_INSTALL_NESTED_SUBDIR}>>>:/testing>")
+set(SwiftTesting_INSTALL_CLANGMODULEDIR "${CMAKE_INSTALL_LIBDIR}/swift$<$<NOT:$<BOOL:${BUILD_SHARED_LIBS}>>:_static>")
 
 add_compile_options($<$<COMPILE_LANGUAGE:Swift>:-no-toolchain-stdlib-rpath>)
 
diff --git a/Sources/Overlays/_Testing_AppKit/CMakeLists.txt b/Sources/Overlays/_Testing_AppKit/CMakeLists.txt
index 7f242534..844e434b 100644
--- a/Sources/Overlays/_Testing_AppKit/CMakeLists.txt
+++ b/Sources/Overlays/_Testing_AppKit/CMakeLists.txt
@@ -16,9 +16,11 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
     Testing
     _Testing_CoreGraphics)
 
-  target_compile_options(_Testing_AppKit PRIVATE
-    -enable-library-evolution
-    -emit-module-interface -emit-module-interface-path $<TARGET_PROPERTY:_Testing_AppKit,Swift_MODULE_DIRECTORY>/_Testing_AppKit.swiftinterface)
+  if(SwiftTesting_ENABLE_LIBRARY_EVOLUTION)
+    target_compile_options(_Testing_AppKit PRIVATE
+      -enable-library-evolution
+      -emit-module-interface -emit-module-interface-path $<TARGET_PROPERTY:_Testing_AppKit,Swift_MODULE_DIRECTORY>/_Testing_AppKit.swiftinterface)
+  endif()
 
   _swift_testing_install_target(_Testing_AppKit)
 endif()
